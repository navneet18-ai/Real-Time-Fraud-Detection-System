# Environment Configuration for Real-Time Fraud Detection System

# Application Mode & Ports
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Database Configuration
DATABASE_URL=sqlite:///./fraud_detection.db

# Model Artifact Paths
MODEL_PATH=models/fraud_detection_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib
METRICS_PATH=models/model_metrics.json

# Fraud Risk Thresholds (Configurable: 0.0 to 1.0)
RISK_THRESHOLD_LOW=0.20
RISK_THRESHOLD_HIGH=0.65

# Data Paths
RAW_DATA_PATH=data/creditcard.csv
SAMPLE_DATA_PATH=data/sample_transactions.csv
