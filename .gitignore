# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# SQLite databases (keep schema reproducible, ignore runtime DB)
*.db
*.sqlite
*.sqlite3

# Large dataset files (do not commit 150MB Kaggle CSV to git)
data/*.csv
data/*.zip
!data/.gitkeep
!data/sample_transactions.csv

# Machine Learning model binaries
models/*.joblib
models/*.pkl
!models/.gitkeep

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.DS_Store
.vscode/
.idea/
